{
  "manifest_version": 3,
  "name": "chitgit - Commit Plagiarism & CSV Exporter",
  "version": "1.1.0",
  "description": "Inspect GitHub commits for code plagiarism using Google Gemini AI and export detailed CSV reports.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "chitgit - Commit Plagiarism Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
